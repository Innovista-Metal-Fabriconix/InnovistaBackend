generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  CustomerId      Int         @id @default(autoincrement())
  Cus_Name        String
  Cus_Email       String      @unique
  Cus_PhoneNumber String
  Cus_CompanyName String?
  Cus_Logo        String?
  Verify_State    Boolean     @default(false)
  Cus_Password    String
  Purchase_Goods  String[]
  FeedBacks       Feed_Back[]
  Orders          Order[]
}

model Admin {
  AdminId        Int           @id @default(autoincrement())
  Admin_Name     String
  Admin_Email    String        @unique
  Admin_Phone    String
  Admin_Profile  String?
  Admin_Password String
  Designs        Design[]
  RefreshToken   RefreshToken?
}

model RefreshToken {
  id       Int      @id @default(autoincrement())
  adminId  Int      @unique
  token    String
  issuedAt DateTime
  expiryAt DateTime
  Admin    Admin    @relation(fields: [adminId], references: [AdminId])
}

model Feed_Back {
  Feed_backId       Int      @id @default(autoincrement())
  Feed_back_comment String
  Feed_Back_Images  String[]
  Rating            Int
  CustomerId        Int
  DesignID          Int
  Customer          Customer @relation(fields: [CustomerId], references: [CustomerId])
  Design            Design   @relation(fields: [DesignID], references: [DesignID])
}

model Notifications {
  NotificationsID     Int      @id @default(autoincrement())
  Date_Timestamp      DateTime @default(now())
  SenderEmail         String
  Recevied_Emails     String[]
  View_List           String[]
  Notifications_Body  String
  Notifications_Title String
}

model Design {
  DesignID           Int           @id @default(autoincrement())
  Design_Name        String
  Design_Image       String[]
  Design_Description String
  Categories         String[]
  Design_Colors      String[]
  Design_BlogPosts   String[]
  Design_Sizes       String[]
  Design_CreatedAt   DateTime      @default(now())
  AdminId            Int
  Admin              Admin         @relation(fields: [AdminId], references: [AdminId])
  FeedBacks          Feed_Back[]
  Orders             OrderDesign[]
}

model Project {
  ProjectID            Int       @id @default(autoincrement())
  Project_Title        String
  Project_Description  String
  Project_Images       String[]
  Project_CreatedAt    DateTime  @default(now())
  Location             String
  Client_Name          String
  Client_Email         String
  Client_Number        String?
  Client_Company       String?
  Project_FinishedDate DateTime?
  Budget               Float
}

model Order {
  OrderID       Int           @id @default(autoincrement())
  CustomerId    Int?
  Order_Date    DateTime      @default(now())
  Order_Status  String
  Client_Name   String?
  Client_Email  String?
  Client_Number String?
  Customer      Customer?     @relation(fields: [CustomerId], references: [CustomerId])
  Designs       OrderDesign[]
}

/// Join table for many-to-many between Order and Design
model OrderDesign {
  id       Int    @id @default(autoincrement())
  orderId  Int
  designId Int
  Design   Design @relation(fields: [designId], references: [DesignID])
  Order    Order  @relation(fields: [orderId], references: [OrderID])

  @@unique([orderId, designId])
}
