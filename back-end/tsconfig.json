{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "ignoreDeprecations": "5.0",
    "outDir": "./dist",
    "rootDir": "./",
    "declaration": true,
    "sourceMap": true,
    "removeComments": true,
    "incremental": true,
    "strict": true,
    "noImplicitAny": false,    
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "api"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}